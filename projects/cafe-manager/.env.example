# ============================================================
# كافيه برو — إعدادات البيئة
# انسخ الملف إلى ‎.env‎ ثم عدّل القيم.
# ============================================================

# محليًا (SQLite): اترك DATABASE_URL معطّلًا/فارغًا.
# على الاستضافة (MySQL/MariaDB): فعّل السطر التالي.
# إذا كانت كلمة المرور تحتوي @ أو # أو / أو : استخدم ترميز URL:
# @ → %40، # → %23، / → %2F، : → %3A
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# منفذ التطبيق (معظم الاستضافات تضبطه تلقائيًا)
# PORT=3000

# مسار قاعدة SQLite المحلية (اختياري)
# CAFE_DB=./cafe.db

# NODE_ENV=production
