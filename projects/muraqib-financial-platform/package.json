{
  "name": "muraqib-financial-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "منصة المراقب المالي المعتمد | Muraqib Certified Financial Controller Platform - نظام متكامل لإدارة أعمال المراقبين الماليين المعتمدين، الشركات، القوائم المالية، التحليل المالي، المراجعة والاعتماد",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
