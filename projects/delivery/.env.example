# ============================================================
# طلباتك — إعدادات البيئة
# انسخ هذا الملف إلى ‎.env‎ ثم عدّل القيم.
# ============================================================

# محليًا (SQLite): اترك DATABASE_URL معطّلًا/فارغًا.
# على الاستضافة (MySQL/MariaDB): فعّل السطر التالي وضع بيانات قاعدة البيانات.
# ملاحظة: إذا كانت كلمة المرور تحتوي رموزًا مثل @ أو # أو / فاستخدم
# ترميز URL (مثال: @ → %40، # → %23، / → %2F).
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# المنفذ الذي يستمع عليه التطبيق (معظم الاستضافات تضبطه تلقائيًا)
# PORT=8080

# عنوان الاستماع — اتركه 0.0.0.0 على الاستضافة
# HOST=0.0.0.0

# مجلد البيانات (النسخ الاحتياطية محليًا، وقاعدة SQLite إن لم يوجد DATABASE_URL)
# على الاستضافة استخدم مسارًا دائمًا وقابلًا للكتابة، مثال:
# TALABATAK_DATA=/home/USER/talabatak-data
# TALABATAK_DATA=./data

# NODE_ENV=production
